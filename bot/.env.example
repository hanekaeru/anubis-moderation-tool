# Copier en .env et renseigner les valeurs. Ce fichier ne contient aucun secret.

NODE_ENV=development

# Meme base que l'API.
DATABASE_URL=postgresql://utilisateur:motdepasse@127.0.0.1:5432/anubis-dev

# Portail developpeur Discord (discord.com/developers/applications) :
# Bot > Reset Token pour BOT_TOKEN, General Information > Application ID
# pour CLIENT_ID.
BOT_TOKEN=
CLIENT_ID=

# Serveur Discord ou les commandes slash sont enregistrees (mode
# developpeur active dans Discord > clic droit sur le serveur > Copier l'ID).
GUILD_HOST_ID=

# --- Reglages facultatifs -------------------------------------------------
# Tous ont une valeur par defaut : les laisser commentes convient a un
# serveur de taille normale. Une valeur nulle ou negative est ignoree au
# profit du defaut (voir `readInt` dans src/env.ts).

# Compteurs d'activite gardes en memoire entre deux ecritures en base.
# Monter la taille reduit le nombre d'ecritures, mais un arret brutal perd
# d'autant plus : l'arret propre (SIGINT/SIGTERM) vide le buffer.
# ACTIVITY_BUFFER_SIZE=200
# ACTIVITY_FLUSH_DELAY=15000

# Meme mecanisme pour l'XP.
# MAX_BUFFER_SIZE=50
# MAX_WAIT_TIME_BETWEEN_FLUSH=10000

# Delai minimal entre deux annonces de montee de niveau pour un meme membre.
# COOLDOWN_BETWEEN_LEVEL_UP_MESSAGE=60000
