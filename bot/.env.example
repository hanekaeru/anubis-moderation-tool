# Copier en .env et renseigner les valeurs. Ce fichier ne contient aucun secret.

NODE_ENV=development

# Meme base que l'API.
DATABASE_URL=postgresql://utilisateur:motdepasse@127.0.0.1:5432/anubis-dev

# Portail developpeur Discord (discord.com/developers/applications) :
# Bot > Reset Token pour BOT_TOKEN, General Information > Application ID
# pour CLIENT_ID.
BOT_TOKEN=
CLIENT_ID=

# Serveur Discord ou les commandes slash sont enregistrees (mode
# developpeur active dans Discord > clic droit sur le serveur > Copier l'ID).
GUILD_HOST_ID=
