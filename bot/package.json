  "version": "1.0.0",
  "description": "Discord Mod Bot and Utilities",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "start:dev": "nodemon",
    "start:prod": "node dist/index.js",
    "refresh": "node --env-file=.env -r ts-node/register refresh.ts",
