{
	"name": "divinium-bot",
	"version": "1.0.0",
	"description": "Discord Mod Bot and Utilities",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"//env-file": "`-if-exists` et non `--env-file` sec : en conteneur il n'y a aucun fichier .env, les variables sont injectees directement dans l'environnement. Sans ce suffixe, la commande echoue avant meme de demarrer. Une variable reellement absente reste signalee par `requireEnv`.",
		"start": "node --env-file-if-exists=.env dist/index.js",
		"start:dev": "nodemon",
		"start:prod": "node dist/index.js",
		"refresh": "node --env-file-if-exists=.env -r ts-node/register refresh.ts",
		"delete": "node --env-file-if-exists=.env -r ts-node/register delete_command.ts",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"author": "hanekaeru",
	"license": "ISC",
	"dependencies": {
		"@anubis/shared": "file:../packages/shared",
		"discord.js": "^14.15.3"
	},
	"devDependencies": {
		"@types/node": "^20.14.10",
		"nodemon": "^3.1.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.5.3"
	}
}
