{
	"extends": "./tsconfig.json",
	// Contrairement a `nest build`, `tsc` seul ne decouvre pas ce fichier tout
	// seul : `npm run build` doit passer `-p tsconfig.build.json` explicitement.
	// Les specs restent dans tsconfig.json (projet vu par l'IDE et ts-jest,
	// avec "types": ["node", "jest"]) mais sont exclues de dist/.
	"exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
