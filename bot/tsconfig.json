{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "CommonJS",
		"moduleResolution": "Node",
		"outDir": "dist",
		"rootDir": ".",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"incremental": true
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
