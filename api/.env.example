# Copier en .env et renseigner les valeurs. Ce fichier ne contient aucun secret.

NODE_ENV=development
PORT=3000

# Prefixe de toutes les routes. `api` par defaut, donc inutile en local.
# A mettre a la chaine vide derriere un reverse proxy qui route par chemin
# (`/api` -> ce conteneur) : le proxy retire deja le prefixe, le remettre ici
# ferait repondre 404 sur toutes les routes.
# API_GLOBAL_PREFIX=

# Meme base que le bot.
DATABASE_URL=postgresql://utilisateur:motdepasse@127.0.0.1:5432/anubis-dev

# Identifiant du serveur Discord administre par ce dashboard.
GUILD_ID=

# Generer chacun avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Les deux doivent etre differents et ne jamais etre partages.
#
# ACCESS  : signe les access tokens (JWT).
# REFRESH : clef HMAC des refresh tokens en base. Le modifier invalide toutes
#           les sessions ouvertes — tout le monde doit se reconnecter.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Durees de vie des jetons.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Origine du dashboard Angular, pour CORS. Plusieurs valeurs separees par une virgule.
CORS_ORIGINS=http://localhost:4200

# Mettre a true derriere HTTPS : pose le cookie de refresh en Secure.
COOKIE_SECURE=false

# Verrouillage du compte apres N echecs consecutifs.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Double authentification (TOTP). A `false`, le second facteur n'est plus
# demande a la connexion — y compris aux comptes qui l'avaient active — et les
# ecrans de configuration sont fermes. Prevu pour les phases de test ; les
# secrets deja enregistres sont conserves, remettre `true` rend la protection
# sans reconfiguration.
TWO_FACTOR_ENABLED=true

# --- Verification Battle.net ----------------------------------------------
# Seconde etape facultative de la quarantaine. Le client se cree sur le portail
# developpeur Blizzard (community.developer.battle.net > API Access > Clients).
#
# Les trois variables vont ensemble : il en manque une et la verification est
# annoncee indisponible, plutot que d'envoyer les arrivants sur une erreur
# Blizzard. Laisser vide desactive la fonctionnalite ; le dashboard le signale
# si le reglage est malgre tout exige.
#
# BATTLENET_REDIRECT_URI doit correspondre **au caractere pres** a l'URI
# declaree cote Blizzard, protocole et barre finale comprises.
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_REDIRECT_URI=http://localhost:3000/api/verification/battlenet/callback
