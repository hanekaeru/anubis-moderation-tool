{
	"compilerOptions": {
		"module": "CommonJS",
		"moduleResolution": "Node",
		"declaration": true,
		"removeComments": false,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"target": "ES2022",
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"incremental": true,
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"strictBindCallApply": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"resolveJsonModule": true,
		// Sans cette liste, TypeScript ramasse tous les `@types/*` presents
		// n'importe ou dans le monorepo (typeRoots remonte l'arborescence) —
		// notamment `@types/jasmine`, hoiste par le webapp, dont le global
		// `expect` entre en collision avec celui de Jest et casse `rejects`,
		// `any`, `objectContaining` dans les specs.
		"types": ["node", "jest"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
